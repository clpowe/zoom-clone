import { describe, expect, it } from "vitest";
import { createRoomAndNavigate, canSubmitCreateRoom } from "./useCreateRoom";

describe("createRoomAndNavigate", () => {
  it("creates a room and navigates to the local room id", async () => {
    let requestedTitle = "";
    let navigatedTo = "";

    await createRoomAndNavigate({
      title: "Team Standup",
      createRoom: async ({ title }) => {
        requestedTitle = title;

        return {
          data: {
            id: "local-room-123",
            title,
            cloudflareMeetingId: "cf-meeting-123",
            createdAt: "2026-07-06T10:00:00.000Z",
          },
        };
      },
      navigateToRoom: async (roomId) => {
        navigatedTo = `/room/${roomId}`;
      },
    });

    expect(requestedTitle).toBe("Team Standup");
    expect(navigatedTo).toBe("/room/local-room-123");
  });

  it("trims the room title before creating the room", async () => {
    let requestedTitle = "";

    await createRoomAndNavigate({
      title: "  Family Call  ",
      createRoom: async ({ title }) => {
        requestedTitle = title;

        return {
          data: {
            id: "local-room-456",
            title,
            cloudflareMeetingId: "cf-meeting-456",
            createdAt: "2026-07-06T10:00:00.000Z",
          },
        };
      },
      navigateToRoom: async () => {},
    });

    expect(requestedTitle).toBe("Family Call");
  });

  it("rejects empty room titles before calling the API", async () => {
    let apiCalled = false;

    await expect(
      createRoomAndNavigate({
        title: "   ",
        createRoom: async () => {
          apiCalled = true;
          throw new Error("should not be called");
        },
        navigateToRoom: async () => {},
      }),
    ).rejects.toThrow("Room title is required");

    expect(apiCalled).toBe(false);
  });
});

describe("canSubmitCreateRoom", () => {
  it("allows submission only when the title is filled and a room is not already being created", () => {
    expect(canSubmitCreateRoom({ title: "Team Standup", isCreatingRoom: false })).toBe(true);
    expect(canSubmitCreateRoom({ title: "   ", isCreatingRoom: false })).toBe(false);
    expect(canSubmitCreateRoom({ title: "Team Standup", isCreatingRoom: true })).toBe(false);
  });
});
